# ──────────────────────────────────────────────
# Entorno
# ──────────────────────────────────────────────
ENV=development

# ──────────────────────────────────────────────
# Base de datos principal (PostgreSQL en Supabase)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/velocambio?sslmode=require&connect_timeout=10
DATABASE_TYPE=postgresql
DATABASE_ECHO=False

# ──────────────────────────────────────────────
# JWT (Autenticación)
# ──────────────────────────────────────────────
SECRET_KEY_JWT=[LLAVE_SECRETA]
ALGORITHIM_HASH_JWT=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=90

# ──────────────────────────────────────────────
# Fetch de tasas (Rates)
# ──────────────────────────────────────────────
FETCH_INTERVAL_MINUTES=10
DOLARAPI_BASE_URL=https://ve.dolarapi.com/v1
BINANCE_P2P_BASE_URL=https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search
BCV_BASE_URL=https://www.bcv.org.ve
BCV_VERIFY_SSL=False
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
